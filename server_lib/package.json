{
  "name": "server_utilities",
  "version": "1.0.0",
  "description": "Server-side cryptographic operations for e3vote (napi-rs native addon)",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "e3vote",
    "cryptography",
    "elgamal",
    "blind-signatures",
    "napi-rs"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "*.node"
  ],
  "napi": {
    "binaryName": "server_utilities",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.2.0"
  },
  "packageManager": "yarn@4.12.0"
}
